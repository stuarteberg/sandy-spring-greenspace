---
import BaseLayout from '../layouts/BaseLayout.astro';

const easements = [
  {
    name: "Sample Easement Property",
    acres: 50,
    year: 2020,
    description: "A beautiful mix of forest and farmland along a tributary of the Patuxent River.",
    features: ["Mature hardwood forest", "Agricultural fields", "Stream corridor"]
  },
  {
    name: "Another Protected Property",
    acres: 35,
    year: 2018,
    description: "Historic farmland that has been in the same family for over a century.",
    features: ["Active farmland", "Hedgerows", "Wildlife habitat"]
  },
  {
    name: "Woodland Conservation Area",
    acres: 75,
    year: 2015,
    description: "Contiguous forest providing important wildlife corridor connections.",
    features: ["Upland forest", "Wetlands", "Native plant communities"]
  },
];
---

<BaseLayout title="Our Easements">
  <section class="page-header">
    <div class="container">
      <h1>Our Easements</h1>
      <p>Properties protected through conservation easements with GSSGS.</p>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <div class="intro">
        <p>Since our founding, Greater Sandy Spring Green Space has worked with landowners to permanently protect properties throughout our service area. Each easement represents a landowner's commitment to preserving their land for future generations.</p>
        <p>Below are some examples of the types of properties we have helped protect. For privacy reasons, we do not disclose the specific locations of our easement properties.</p>
      </div>

      <div class="easements-grid">
        {easements.map((easement) => (
          <div class="easement-card">
            <div class="easement-image">
              <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="400" height="200" fill="#e8f5e9"/>
                <path d="M0 150 Q100 120 200 140 T400 130 V200 H0 Z" fill="#4a7c5c"/>
                <path d="M0 170 Q100 150 200 160 T400 150 V200 H0 Z" fill="#2d5a3d"/>
                <circle cx="50" cy="80" r="30" fill="#4a7c5c"/>
                <circle cx="120" cy="90" r="25" fill="#2d5a3d"/>
                <circle cx="85" cy="70" r="28" fill="#3d6b4a"/>
              </svg>
            </div>
            <div class="easement-content">
              <h3>{easement.name}</h3>
              <div class="easement-meta">
                <span class="acres">{easement.acres} acres</span>
                <span class="year">Protected {easement.year}</span>
              </div>
              <p>{easement.description}</p>
              <ul class="features">
                {easement.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="total-impact">
        <h2>Our Impact</h2>
        <div class="impact-stats">
          <div class="impact-stat">
            <span class="number">500+</span>
            <span class="label">Acres Protected</span>
          </div>
          <div class="impact-stat">
            <span class="number">15+</span>
            <span class="label">Conservation Easements</span>
          </div>
          <div class="impact-stat">
            <span class="number">20+</span>
            <span class="label">Years of Service</span>
          </div>
        </div>
      </div>

      <div class="cta-section">
        <h2>Want to Protect Your Land?</h2>
        <p>Join the landowners who have chosen to permanently protect their property for future generations.</p>
        <a href="/easements" class="btn btn-primary">Learn About Easements</a>
        <a href="/join#contact" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-forest-dark) 0%, var(--color-forest) 100%);
    color: var(--color-white);
    padding: var(--spacing-xl) 0;
    text-align: center;
  }

  .page-header h1 {
    color: var(--color-white);
    margin: 0 0 var(--spacing-sm);
  }

  .page-header p {
    font-size: 1.25rem;
    opacity: 0.9;
    margin: 0;
  }

  .content {
    padding: var(--spacing-xl) 0;
  }

  .intro {
    max-width: 800px;
    margin: 0 auto var(--spacing-lg);
    text-align: center;
  }

  .intro p {
    color: var(--color-text-light);
    line-height: 1.8;
  }

  .easements-grid {
    display: grid;
    gap: var(--spacing-md);
  }

  .easement-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
    .easement-card {
      grid-template-columns: 1fr;
    }
  }

  .easement-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .easement-content {
    padding: var(--spacing-md);
  }

  .easement-content h3 {
    margin: 0 0 var(--spacing-xs);
  }

  .easement-meta {
    display: flex;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .easement-meta span {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .easement-meta .acres {
    color: var(--color-meadow);
    font-weight: 600;
  }

  .easement-content p {
    color: var(--color-text-light);
    margin: 0 0 var(--spacing-sm);
  }

  .features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .features li {
    background: var(--color-cream);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    color: var(--color-forest);
  }

  .total-impact {
    margin-top: var(--spacing-xl);
    text-align: center;
  }

  .total-impact h2 {
    margin-bottom: var(--spacing-md);
  }

  .impact-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    max-width: 600px;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .impact-stats {
      grid-template-columns: 1fr;
    }
  }

  .impact-stat {
    background: var(--color-white);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .impact-stat .number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-forest);
  }

  .impact-stat .label {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .cta-section {
    margin-top: var(--spacing-xl);
    background: var(--color-meadow);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-align: center;
  }

  .cta-section h2 {
    color: var(--color-white);
    margin: 0 0 var(--spacing-sm);
  }

  .cta-section p {
    color: var(--color-white);
    opacity: 0.9;
    margin: 0 0 var(--spacing-md);
  }

  .cta-section .btn {
    margin: 0 0.5rem;
  }

  .cta-section .btn-primary {
    background: var(--color-forest-dark);
  }

  .cta-section .btn-outline {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .cta-section .btn-outline:hover {
    background: var(--color-white);
    color: var(--color-forest-dark);
  }
</style>
